{
  "Jwt": {
    "Key": "super-secret-key-troque-em-producao-pelo-menos-32chars!!",
    "Issuer": "taskflow",
    "Audience": "taskflow-clients",
    "ExpiresInMinutes": 60
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "user-service",
        "Match": { "Path": "/users/{**catch-all}" }
      },
      "tasks-route": {
        "ClusterId": "task-service",
        "Match": { "Path": "/tasks/{**catch-all}" }
      }
    },
    "Clusters": {
      "user-service": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5001" }
        }
      },
      "task-service": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5002" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://localhost:5000"
}
